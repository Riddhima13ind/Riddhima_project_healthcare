      <aliases enabled='yes' />
      <column caption='Exercise Level Label' datatype='string' name='[Calculation_1345035129233408]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [exercise_level] = 0 THEN &quot;Sedentary&quot;&#13;&#10;ELSEIF [exercise_level] = 1 THEN &quot;Moderate Active&quot;&#13;&#10;ELSE &quot;Highly Active&quot;&#13;&#10;END' />
      </column>
      <column caption='Smoking Status' datatype='string' name='[Calculation_1345035129499651]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [smoking] = 1 THEN &quot;Smoker&quot; ELSE &quot;Non-Smoker&quot; END' />
      </column>
      <column caption='Alcohol Status' datatype='string' name='[Calculation_1345035129692164]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [alcohol] = 1 THEN &quot;Alcohol Consumer&quot; ELSE &quot;Non-Consumer&quot; END' />
      </column>
      <column caption='Age Bracket' datatype='string' name='[Calculation_1345035129827333]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [age] &lt; 30 THEN &quot;18-29&quot;&#13;&#10;ELSEIF [age] &lt; 45 THEN &quot;30-44&quot;&#13;&#10;ELSEIF [age] &lt; 60 THEN &quot;45-59&quot;&#13;&#10;ELSE &quot;60+&quot;&#13;&#10;END' />
      </column>
      <column caption='BMI category' datatype='string' name='[Calculation_1345035139489798]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [bmi] &lt; 18.5 THEN &quot;Underweight&quot;&#13;&#10;ELSEIF [bmi] &lt; 25.0 THEN &quot;Normal Weight&quot;&#13;&#10;ELSEIF [bmi] &lt; 30.0 THEN &quot;Overweight&quot;&#13;&#10;ELSE &quot;Obese&quot;&#13;&#10;END' />
      </column>
